# ============================================================
# 环境变量示例（本地开发复制为 .env；线上部署配在 Vercel Settings）
# ============================================================

# 大模型提供商：moonshot（Kimi，默认） | volcano_ark（火山方舟/豆包） | deepseek（DeepSeek）
LLM_PROVIDER=moonshot

# Moonshot Kimi API 密钥（LLM_PROVIDER=moonshot 时必填）
# 获取：https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx

# 火山方舟（豆包）API 密钥（LLM_PROVIDER=volcano_ark 时必填）
# 获取：https://console.volcengine.com/ark → API Key 管理
DOUBAO_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# DeepSeek API 密钥（LLM_PROVIDER=deepseek 时必填）
# 获取：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 通义千问 / 阿里云百炼 API 密钥（LLM_PROVIDER=qwen 时必填）
# 获取：https://bailian.console.aliyun.com → API-KEY
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：覆盖各自默认模型
# MOONSHOT_MODEL=kimi-k3.1-pro
# DOUBAO_MODEL=doubao-seed-2-1-pro-260915
# DEEPSEEK_MODEL=deepseek-chat   # 或 deepseek-reasoner（R1）
# QWEN_MODEL=qwen-plus           # 或 qwen-max / qwen-turbo

# Supabase 项目 URL（若需落库）
# 获取：Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase 密钥（二选一）：
# 1) 推荐：服务端 Service Role Key（可绕过 RLS，仅用于服务端）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# 2) 备选：Anon Public Key（配合 schema.sql 中的 anon INSERT 策略使用）
# SUPABASE_ANON_KEY=eyJhbGciOi...
